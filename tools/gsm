#!/usr/bin/env bash
# gsm —— GOST SNI Manager 便携命令
#
# 用途：在 SSH 里不依赖面板、不依赖 jq、不依赖 tty 地查看和切换"出口访问"开关。
# 设计约定（契约第 6/9 节）：
#   * 判定与下发逻辑只有一套，全部在面板的 app.py / egress.py 里；
#     本脚本只是胶水，通过 "python app.py egress-*" 子命令读写，绝不自己写 nft 规则。
#   * allow/deny 先读 egress-domains，本地合并去重后再整体写回，避免并发覆盖。
#   * app.py 的退出码原样透传：0 成功；1 参数错误或本机未启用守卫；3 已保存但下发失败。
#   * 只用 bash 内建与系统自带命令（curl 安装场景下一般为最小系统），不要求 jq。
#   * 全程不读 stdin（除显式文件重定向），非交互 SSH / 管道安装后可直接用。
set -Eeuo pipefail

GSM_VERSION="2.3.0"
APP_DIR="${GSM_APP_DIR:-/opt/gost-sni-manager}"
PY="${GSM_PYTHON:-}"
PROBE_HOST_DEFAULT="${GSM_PROBE_HOST:-1.1.1.1}"
PROBE_PORT_DEFAULT="${GSM_PROBE_PORT:-443}"
LOG_DEFAULT_LINES="${GSM_LOG_LINES:-20}"

# 契约 v3：面板运行参数文件与服务名（测试可用环境变量覆盖）。
PANEL_CONF="${GSM_PANEL_CONF:-/etc/gost-panel/panel.conf}"
PANEL_SERVICE="${GSM_PANEL_SERVICE:-gost-panel}"
PANEL_BIND_DEFAULT="127.0.0.1"
PANEL_PORT_DEFAULT="7080"

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_OK=$'\033[1;32m'
  C_WARN=$'\033[1;33m'
  C_ERR=$'\033[1;31m'
  C_INFO=$'\033[1;36m'
  C_BOLD=$'\033[1;1m'
  C_OFF=$'\033[0m'
else
  C_OK="" C_WARN="" C_ERR="" C_INFO="" C_BOLD="" C_OFF=""
fi

ok()   { printf '%s[ok]%s %s\n' "${C_OK}" "${C_OFF}" "$*"; }
warn() { printf '%s[!]%s %s\n' "${C_WARN}" "${C_OFF}" "$*"; }
err()  { printf '%s[x]%s %s\n' "${C_ERR}" "${C_OFF}" "$*" >&2; }
info() { printf '%s[>]%s %s\n' "${C_INFO}" "${C_OFF}" "$*"; }

usage() {
  cat <<'EOF'
gsm —— GOST SNI Manager 便携命令（出口访问控制）

用法：
  gsm                      查看出口访问状态（同 gsm status）
  gsm status               查看状态：开关、模式、域名数、数据面下发结果
  gsm on [--mode all|allowlist] [--allow a.com,b.com]
                           打开出口访问；默认沿用当前模式
  gsm off                  关闭出口访问（关闭是默认态，关闭即全拒绝出站）
  gsm allow a.com b.com    追加放行域名（不改开关状态）
  gsm deny a.com           删除放行域名（不改开关状态）
  gsm domains              列出当前放行域名
  gsm test [host] [port]   出站连通性探测（默认 1.1.1.1 443）
  gsm log [-n N] [--allow|--block]
                           查看访问流水（采样记录，非全量审计）
  gsm doctor               自检：守卫服务、nft 表、DNS、探测等

面板开关（契约 v3，只影响网页，不影响端口映射转发）：
  gsm panel status [--json]     服务是否运行、监听地址、是否允许远程
  gsm panel on                  启动并开机自启面板（写 ENABLED=1）
  gsm panel off                 停止并禁用面板（写 ENABLED=0）
  gsm panel remote on           允许公网监听 0.0.0.0（危险，会打印警告）
  gsm panel remote off          恢复只监听 127.0.0.1

  gsm install-cli          把本脚本安装到系统（需要 root）
  gsm version              显示版本
  gsm help                 显示本帮助

环境变量：
  GSM_APP_DIR    应用目录，默认 /opt/gost-sni-manager
  GSM_PYTHON     指定 python 解释器（默认按 venv -> python3 -> python 探测）
  GSM_PANEL_CONF 面板参数文件，默认 /etc/gost-panel/panel.conf
  NO_COLOR       设置为非空时关闭彩色输出

退出码：0 成功；1 参数错误、本机未启用出口守卫，或面板服务未运行（panel status）。
        出口写操作另有 3：策略已保存但数据面下发失败。
EOF
}

# ---------- 应用目录与解释器探测 ----------

# 应用目录：GSM_APP_DIR 优先，其次 /opt/gost-sni-manager。
resolve_app_dir() {
  printf '%s' "${APP_DIR}"
}

# 解释器可用性探测：必须不读 stdin，且可能阻塞时要有超时。
# curl 管道安装/非交互 SSH 场景下 stdin 可能已关闭，任何交互式探测都会把 gsm 挂死。
python_usable() {
  local candidate="$1"
  [[ -n "${candidate}" && -x "${candidate}" ]] || return 1
  if command -v timeout >/dev/null 2>&1; then
    timeout 5 "${candidate}" -c 'import sys' </dev/null >/dev/null 2>&1
  else
    "${candidate}" -c 'import sys' </dev/null >/dev/null 2>&1
  fi
}

# python 解释器：GSM_PYTHON 显式指定时直接用它（不再探测）；
# 否则按 $APP_DIR/venv/bin/python -> venv/bin/python3 -> python3 -> python 逐个探测。
resolve_python() {
  if [[ -n "${PY}" ]]; then
    printf '%s' "${PY}"
    return 0
  fi
  local app candidate
  app="$(resolve_app_dir)"
  for candidate in \
    "${app}/venv/bin/python" \
    "${app}/venv/bin/python3" \
    "$(command -v python3 2>/dev/null || true)" \
    "$(command -v python 2>/dev/null || true)"; do
    if python_usable "${candidate}"; then
      printf '%s' "${candidate}"
      return 0
    fi
  done
  return 1
}

# 前置检查：app.py 存在 + 能找到 python，成功时把解释器路径打印到 stdout。
require_env() {
  local app py
  app="$(resolve_app_dir)"
  if [[ ! -f "${app}/app.py" ]]; then
    err "找不到 ${app}/app.py。请确认已安装 GOST SNI Manager，或用 GSM_APP_DIR 指定应用目录。"
    return 1
  fi
  py="$(resolve_python)" || {
    err "找不到可用的 python 解释器（已尝试 venv/bin/python、python3、python）。可用 GSM_PYTHON 指定。"
    return 1
  }
  printf '%s' "${py}"
}

# 重要：本脚本是 set -Eeuo pipefail。简单命令一旦返回非 0，shell 会立刻退出，
# 所以 "cmd; rc=$?" 这种写法在失败时根本走不到赋值，退出码虽然对但提示全丢。
# 统一用下面的 if/else 形式取真实退出码（条件上下文不触发 set -e）。
# 用法：capture_rc <变量名> <命令...>
capture_rc() {
  local __var_name="$1"; shift
  local __rc=0
  if "$@"; then
    __rc=0
  else
    __rc=$?
  fi
  printf -v "${__var_name}" '%s' "${__rc}"
  return 0
}

# 取值型调用：成功时把 stdout 写进变量，同时返回 app.py 的真实退出码。
# 用法：capture_app_out <变量名> <app.py 子命令...>
capture_app_out() {
  local __var_name="$1"; shift
  local py app __out="" __rc=0
  py="$(require_env)" || return 1
  app="$(resolve_app_dir)"
  if __out="$("${py}" "${app}/app.py" "$@")"; then
    __rc=0
  else
    __rc=$?
    __out=""
  fi
  printf -v "${__var_name}" '%s' "${__out}"
  return "${__rc}"
}

# 取值型调用，但丢弃 app.py 的 stderr：用于"可选能力探测"（如尚未实现的
# panel-* 子命令）。老版本 app.py 会往 stderr 打 argparse 用法，不该污染 CLI 输出。
capture_app_out_quiet() {
  local __var_name="$1"; shift
  local py app __out="" __rc=0
  py="$(require_env)" || return 1
  app="$(resolve_app_dir)"
  if __out="$("${py}" "${app}/app.py" "$@" 2>/dev/null)"; then
    __rc=0
  else
    __rc=$?
    __out=""
  fi
  printf -v "${__var_name}" '%s' "${__out}"
  return "${__rc}"
}

# 流式调用：直接透传 app.py 的输出，返回真实退出码。
run_app() {
  local py app rc=0
  py="$(require_env)" || return 1
  app="$(resolve_app_dir)"
  capture_rc rc "${py}" "${app}/app.py" "$@"
  return "${rc}"
}

# 把 app.py 的退出码翻译成契约措辞：
#   0 成功；1 参数/校验错误或本机未启用守卫；3 已保存但数据面下发失败。
explain_rc() {
  case "$1" in
    0) printf '%s' "成功" ;;
    1) printf '%s' "参数或校验错误，或本机未启用出口守卫（未改动策略）" ;;
    3) printf '%s' "策略已保存，但数据面下发失败——数据面仍保持全拒绝" ;;
    *) printf '%s' "退出码 $1" ;;
  esac
}

# ---------- 域名清单合并 ----------

# 规范化一个域名/IP：清掉控制字符与两侧空白、转小写、去掉末尾的点。
normalize_token() {
  local token="$1"
  token="${token#"${token%%[![:space:]]*}"}"
  token="${token%"${token##*[![:space:]]}"}"
  token="$(printf '%s' "${token}" | tr -d '\r\n\t')"
  token="${token,,}"
  # 只去掉"末尾"的点。模式必须写 *.，写成 *.* 会匹配任何含点的域名 -> 死循环。
  while [[ "${token}" == *. ]]; do
    token="${token%.}"
  done
  printf '%s' "${token}"
}

# 读取当前放行域名（每行一个），成功时输出到 stdout，失败返回 app.py 的退出码。
load_domains() {
  local out="" rc=0
  capture_app_out out egress-domains
  rc=$?
  printf '%s\n' "${out}"
  return "${rc}"
}

# 合并写回：$@ 为要追加的域名。已有清单保持原样，整体去重后写回。
apply_domains() {
  local py app list_file merged rc=0 line token
  py="$(require_env)" || return 1
  app="$(resolve_app_dir)"

  # 先确认能读到当前清单：读取失败时绝不能当空清单写回，否则会误删已有规则。
  list_file="$(mktemp)"
  capture_rc rc load_domains
  local load_rc="${rc}"
  if (( load_rc != 0 )); then
    rm -f "${list_file}"
    return "${load_rc}"
  fi
  load_domains > "${list_file}" || true

  declare -A seen=()
  while IFS= read -r line || [[ -n "${line}" ]]; do
    line="$(normalize_token "${line}")"
    [[ -z "${line}" ]] && continue
    seen["${line}"]=1
  done < "${list_file}"
  rm -f "${list_file}"

  for token in "$@"; do
    token="$(normalize_token "${token}")"
    [[ -z "${token}" ]] && continue
    seen["${token}"]=1
  done

  # 排序输出：同一份清单每次写回结果一致，便于比对与回滚。
  merged="$(mktemp)"
  if (( ${#seen[@]} > 0 )); then
    printf '%s\n' "${!seen[@]}" | LC_ALL=C sort > "${merged}"
  else
    : > "${merged}"
  fi

  capture_rc rc "${py}" "${app}/app.py" egress-set --domains-file "${merged}"
  rm -f "${merged}"
  return "${rc}"
}

# ===========================================================================
# 面板开关（契约 v3 第 3/4 节）
#
# 关键点：面板开关**只影响网页**。gost / gsm-egress / caddy 一概不动，
# 端口映射的转发能力继续工作（只是没有网页可以改配置）。
# 状态落两处：/etc/gost-panel/panel.conf（服务启动时读）与 DB settings 表
# （面板内展示用，经 app.py panel-* 同步）。CLI 以 systemd 实况为准。
# ===========================================================================

# 读取 panel.conf 里的某个键；文件或键不存在时输出默认值。永远返回 0。
panel_conf_get() {
  local key="$1" default="${2:-}" value=""
  if [[ -r "${PANEL_CONF}" ]]; then
    # 只取第一个匹配行；去掉可能存在的 CR（有人在 Windows 上编辑过文件）。
    value="$(sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*//p" "${PANEL_CONF}" 2>/dev/null | head -n 1 | tr -d "\r")"
  fi
  [[ -n "${value}" ]] || value="${default}"
  printf "%s" "${value}"
}

# 写 panel.conf 的若干键，保留其余键、注释与顺序。
# 用法：panel_conf_set KEY=VALUE [KEY=VALUE ...]
# 走"临时文件 + mv"，避免写一半留下坏文件。
panel_conf_set() {
  local pair key value line found_key rc=0 tmp_dir tmp_file
  local -a keys=()
  declare -A new_values=() done_keys=()

  for pair in "$@"; do
    key="${pair%%=*}"
    value="${pair#*=}"
    [[ -n "${key}" ]] || continue
    keys+=("${key}")
    new_values["${key}"]="${value}"
  done
  (( ${#keys[@]} > 0 )) || return 0

  tmp_dir="$(dirname "${PANEL_CONF}")"
  if [[ ! -d "${tmp_dir}" ]]; then
    capture_rc rc mkdir -p "${tmp_dir}"
    if (( rc != 0 )); then
      err "无法创建目录 ${tmp_dir}（退出码 ${rc}）。"
      return "${rc}"
    fi
  fi
  tmp_file="$(mktemp "${tmp_dir}/.panel.conf.XXXXXX")" || {
    err "无法在 ${tmp_dir} 创建临时文件。"
    return 1
  }

  # 先复制现有内容，再逐行改写命中的键。
  if [[ -r "${PANEL_CONF}" ]]; then
    while IFS= read -r line || [[ -n "${line}" ]]; do
      line="${line%'\r'}"
      found_key=""
      for key in "${keys[@]}"; do
        if [[ "${line}" =~ ^[[:space:]]*${key}[[:space:]]*= ]]; then
          found_key="${key}"
          break
        fi
      done
      if [[ -n "${found_key}" ]]; then
        # 重复的同名键只保留第一次出现的位置。
        if [[ -z "${done_keys[${found_key}]:-}" ]]; then
          printf "%s=%s\n" "${found_key}" "${new_values[${found_key}]}" >> "${tmp_file}"
          done_keys["${found_key}"]=1
        fi
      else
        printf "%s\n" "${line}" >> "${tmp_file}"
      fi
    done < "${PANEL_CONF}"
  fi

  # 原文件里没有的键追加到末尾。
  for key in "${keys[@]}"; do
    if [[ -z "${done_keys[${key}]:-}" ]]; then
      printf "%s=%s\n" "${key}" "${new_values[${key}]}" >> "${tmp_file}"
    fi
  done

  # 文件只含绑定地址/端口/开关，不含口令；用 0644 方便面板进程读取。
  chmod 0644 "${tmp_file}" 2>/dev/null || true
  if ! mv -f "${tmp_file}" "${PANEL_CONF}"; then
    rm -f "${tmp_file}"
    err "写入 ${PANEL_CONF} 失败。"
    return 1
  fi
  return 0
}

# 服务是否在运行：输出 active / inactive / unknown。永远返回 0（只做展示）。
panel_service_state() {
  local state=""
  if ! command -v systemctl >/dev/null 2>&1; then
    printf "unknown"
    return 0
  fi
  if state="$(systemctl is-active "${PANEL_SERVICE}" 2>/dev/null)"; then
    printf "%s" "${state:-unknown}"
  else
    printf "%s" "${state:-inactive}"
  fi
}

# 服务是否开机自启：输出 enabled / disabled / unknown。永远返回 0。
panel_service_enabled() {
  local state=""
  if ! command -v systemctl >/dev/null 2>&1; then
    printf "unknown"
    return 0
  fi
  state="$(systemctl is-enabled "${PANEL_SERVICE}" 2>/dev/null || true)"
  printf "%s" "${state:-unknown}"
}

# 从 unit 的 --bind 解析出监听端点（形如 127.0.0.1:52595）。拿不到输出空。
panel_unit_endpoint() {
  local unit_text=""
  if command -v systemctl >/dev/null 2>&1; then
    unit_text="$(systemctl cat "${PANEL_SERVICE}" 2>/dev/null || true)"
    if [[ "${unit_text}" =~ --bind[[:space:]]+([^[:space:]]+) ]]; then
      printf "%s" "${BASH_REMATCH[1]}"
    fi
  fi
}

# 面板端口：panel.conf 优先，其次 unit，最后默认值。
panel_port() {
  local port endpoint=""
  port="$(panel_conf_get PORT "")"
  if [[ -z "${port}" ]]; then
    endpoint="$(panel_unit_endpoint)"
    [[ "${endpoint}" == *:* ]] && port="${endpoint##*:}"
  fi
  [[ -n "${port}" ]] || port="${PANEL_PORT_DEFAULT}"
  printf "%s" "${port}"
}

# 面板绑定地址：panel.conf 优先，其次 unit，最后默认 127.0.0.1。
panel_bind() {
  local bind="" endpoint=""
  bind="$(panel_conf_get BIND "")"
  if [[ -z "${bind}" ]]; then
    endpoint="$(panel_unit_endpoint)"
    [[ "${endpoint}" == *:* ]] && bind="${endpoint%:*}"
  fi
  [[ -n "${bind}" ]] || bind="${PANEL_BIND_DEFAULT}"
  printf "%s" "${bind}"
}

# 实际生效的监听地址（展示用）：把 bind 与 port 拼起来。
panel_effective_bind() {
  printf "%s:%s" "$(panel_bind)" "$(panel_port)"
}
# 从主 unit 文件解析原始 ExecStart 命令（不含 "ExecStart=" 前缀）。
# 刻意不读 systemctl cat 的合并输出：那里面已经含我们自己写的 drop-in，
# 拿它当"原始命令行"会导致幂等判断永远不成立（每次都重启）。
# 主 unit 不可读时退回 systemctl cat 的第一条 ExecStart。
panel_unit_execstart() {
  local unit_file="" line="" last=""
  for unit_file in \
    "/etc/systemd/system/${PANEL_SERVICE}.service" \
    "/usr/lib/systemd/system/${PANEL_SERVICE}.service" \
    "/lib/systemd/system/${PANEL_SERVICE}.service"; do
    if [[ -r "${unit_file}" ]]; then
      while IFS= read -r line || [[ -n "${line}" ]]; do
        line="${line%$'\r'}"
        if [[ "${line}" =~ ^[[:space:]]*ExecStart=[[:space:]]*(.+)$ ]]; then
          last="${BASH_REMATCH[1]}"
        fi
      done < "${unit_file}"
      [[ -n "${last}" ]] && break
    fi
  done
  if [[ -z "${last}" ]] && command -v systemctl >/dev/null 2>&1; then
    # 兜底：取 systemctl cat 输出的第一条非空 ExecStart（通常是主 unit 的）。
    while IFS= read -r line || [[ -n "${line}" ]]; do
      line="${line%$'\r'}"
      if [[ "${line}" =~ ^[[:space:]]*ExecStart=[[:space:]]*(.+)$ ]]; then
        last="${BASH_REMATCH[1]}"
        break
      fi
    done <<< "$(systemctl cat "${PANEL_SERVICE}" 2>/dev/null || true)"
  fi
  printf "%s" "${last}"
}

# 把一条 ExecStart 命令行里的 --bind 取值换成指定端点；没有 --bind 就补一个。
# 用法：panel_rewrite_bind <原命令行> <bind:port>
panel_rewrite_bind() {
  local cmdline="$1" endpoint="$2"
  if [[ "${cmdline}" =~ (--bind[[:space:]]+)[^[:space:]]+ ]]; then
    # 用 %% 做一次最长前缀匹配 + # 做最短后缀，避免 sed 转义问题。
    local prefix="${cmdline%%--bind*}"
    local rest="${cmdline#*--bind}"
    # rest 形如 " 127.0.0.1:52595 wsgi:app"，去掉前导空白与旧取值
    rest="${rest#"${rest%%[![:space:]]*}"}"
    local suffix="${rest#* }"
    printf "%s--bind %s %s" "${prefix}" "${endpoint}" "${suffix}"
  else
    printf "%s --bind %s" "${cmdline}" "${endpoint}"
  fi
}

# 面板运行参数文件不存在时，按当前 unit 的 --bind 生成一份（契约 v3：无法解析就退默认）。
# 这样老版本安装升上来的机器第一次执行 gsm panel 就能纳管。
panel_conf_ensure() {
  [[ -f "${PANEL_CONF}" ]] && return 0
  local endpoint bind port
  endpoint="$(panel_unit_endpoint)"
  if [[ "${endpoint}" == *:* ]]; then
    bind="${endpoint%:*}"
    port="${endpoint##*:}"
  else
    bind="${PANEL_BIND_DEFAULT}"
    port="${PANEL_PORT_DEFAULT}"
  fi
  local rc=0
  capture_rc rc panel_conf_set "BIND=${bind}" "PORT=${port}" "ALLOW_REMOTE=0" "ENABLED=1"
  if (( rc != 0 )); then
    err "无法生成 ${PANEL_CONF}（退出码 ${rc}）。"
    return "${rc}"
  fi
  info "已按当前 unit 生成 ${PANEL_CONF}（BIND=${bind} PORT=${port}）。"
  return 0
}

# 关键：systemd unit 里的 --bind 是安装时展开的常量，改 panel.conf 对它无效。
# 因此用 drop-in 覆盖 ExecStart，保证「实际监听地址 == panel.conf 的 BIND」。
# 先清空 ExecStart（systemd 规定覆盖列表型指令必须先置空），再给新值。
# 返回值：0 成功（含已是目标状态）；1 失败。
panel_write_bind_dropin() {
  local rc=0 endpoint bind port cmdline new_cmdline dropin_dir dropin_file current
  endpoint="$(panel_effective_bind)"
  bind="${endpoint%:*}"
  port="${endpoint##*:}"

  dropin_dir="/etc/systemd/system/${PANEL_SERVICE}.service.d"
  dropin_file="${dropin_dir}/bind.conf"

  # 解析当前命令行：优先 unit 里已有的 --bind，其次按默认布局拼一条。
  cmdline="$(panel_unit_execstart)"
  if [[ -z "${cmdline}" ]]; then
    cmdline="/opt/gost-sni-manager/venv/bin/gunicorn --workers 1 --threads 4 --bind ${bind}:${port} wsgi:app"
    local app
    app="$(resolve_app_dir)"
    if [[ -n "${app}" && -d "${app}" ]]; then
      cmdline="${app}/venv/bin/gunicorn --workers 1 --threads 4 --bind ${bind}:${port} wsgi:app"
    fi
    warn "无法从 unit 解析 ExecStart，按默认布局生成 drop-in。"
  fi
  new_cmdline="$(panel_rewrite_bind "${cmdline}" "${endpoint}")"

  # 幂等：内容已经一致且服务在跑，就不做无谓的 restart。
  if [[ -f "${dropin_file}" ]]; then
    current="$(sed -n 's/^ExecStart=//p' "${dropin_file}" 2>/dev/null | grep -v '^$' | tail -n 1 || true)"
    if [[ "${current}" == "${new_cmdline}" ]] && [[ "$(panel_service_state)" == "active" ]]; then
      return 0
    fi
  fi

  # 只有真的写不进去才需要 root：目标目录已存在且可写时允许非 root 运行
  # （本地测试与用户级 systemd 场景）。
  local need_root=0
  if [[ ! -d "${dropin_dir}" ]]; then
    if ! mkdir -p "${dropin_dir}" 2>/dev/null; then
      need_root=1
    fi
  elif [[ ! -w "${dropin_dir}" ]]; then
    need_root=1
  fi
  if (( need_root == 1 )); then
    err "写入 ${dropin_file} 需要 root，请用 sudo gsm panel ..."
    return 1
  fi
  capture_rc rc mkdir -p "${dropin_dir}"
  if (( rc != 0 )); then
    err "无法创建 ${dropin_dir}（退出码 ${rc}）。"
    return 1
  fi

  if ! cat > "${dropin_file}.tmp" <<EOF2
# 由 gsm panel on / remote on|off 维护：绑定地址以 ${PANEL_CONF} 为准。
# 不要手改：执行 gsm panel remote on|off 会重写本文件。
[Service]
ExecStart=
ExecStart=${new_cmdline}
EOF2
  then
    rm -f "${dropin_file}.tmp"
    err "写入 ${dropin_file} 失败。"
    return 1
  fi
  chmod 0644 "${dropin_file}.tmp" 2>/dev/null || true
  if ! mv -f "${dropin_file}.tmp" "${dropin_file}"; then
    rm -f "${dropin_file}.tmp"
    err "安装 ${dropin_file} 失败。"
    return 1
  fi

  capture_rc rc systemctl daemon-reload
  if (( rc != 0 )); then
    err "systemctl daemon-reload 失败（退出码 ${rc}）。"
    return 1
  fi
  # 服务没在运行时不需要 restart：下次 panel on 会按新 drop-in 启动。
  if [[ "$(panel_service_state)" != "active" ]]; then
    return 0
  fi
  capture_rc rc systemctl restart "${PANEL_SERVICE}"
  if (( rc != 0 )); then
    err "重启面板服务失败（systemctl 退出码 ${rc}）。可手动：systemctl restart ${PANEL_SERVICE}"
    return 1
  fi
  return 0
}

# 同步 DB settings（由 app.py 的 panel-* 负责）。老版本 app.py 没有这些
# 子命令，必须容忍失败：只告警，不把 CLI 弄挂，也不改返回值。
panel_sync_db() {
  local want="$1" rc=0
  capture_rc rc capture_app_out_quiet _panel_unused "panel-${want}"
  if (( rc != 0 )); then
    warn "数据库面板状态同步失败（app.py panel-${want} 退出码 ${rc}）；systemd 与 ${PANEL_CONF} 已按预期生效。"
  fi
  return 0
}


# 打开面板：ENABLED=1 + systemctl enable --now。幂等。
panel_enable() {
  local rc=0 state_before bind port allow_remote
  state_before="$(panel_service_state)"
  bind="$(panel_bind)"
  port="$(panel_port)"
  allow_remote="$(panel_conf_get ALLOW_REMOTE 0)"

  capture_rc rc panel_conf_set "ENABLED=1" "BIND=${bind}" "PORT=${port}" "ALLOW_REMOTE=${allow_remote}"
  if (( rc != 0 )); then
    err "写入 ${PANEL_CONF} 失败（退出码 ${rc}），面板未改动。"
    return 1
  fi

  if ! command -v systemctl >/dev/null 2>&1; then
    err "本机没有 systemctl，无法控制面板服务。"
    return 1
  fi

  # 先让 drop-in 的 --bind 与 panel.conf 一致，否则启用后仍会监听旧地址。
  panel_write_bind_dropin
  if (( $? != 0 )); then
    err "无法把监听地址同步到 systemd（见上面的报错），面板未启动。"
    return 1
  fi

  capture_rc rc systemctl enable --now "${PANEL_SERVICE}"
  if (( rc != 0 )); then
    err "启动面板服务失败（systemctl 退出码 ${rc}）。配置已写好，排查：journalctl -u ${PANEL_SERVICE} -n 50"
    return 1
  fi

  if [[ "${state_before}" == "active" ]]; then
    ok "面板已在运行（保持开启，未重启）。"
  else
    ok "面板已开启。"
  fi
  info "监听地址：$(panel_effective_bind)（远程请用 SSH 隧道，见 gsm panel status）"
  panel_sync_db enable
  return 0
}

# 关闭面板：ENABLED=0 + systemctl disable --now。幂等。
panel_disable() {
  local rc=0 state_before
  state_before="$(panel_service_state)"

  capture_rc rc panel_conf_set "ENABLED=0"
  if (( rc != 0 )); then
    err "写入 ${PANEL_CONF} 失败（退出码 ${rc}），面板未改动。"
    return 1
  fi

  if ! command -v systemctl >/dev/null 2>&1; then
    err "本机没有 systemctl，无法控制面板服务。"
    return 1
  fi

  # disable 失败不阻断：先把服务停掉，"停止"比"取消自启"更重要。
  capture_rc rc systemctl disable "${PANEL_SERVICE}"
  if (( rc != 0 )); then
    warn "systemctl disable 返回 ${rc}（继续停止服务）。"
  fi

  capture_rc rc systemctl stop "${PANEL_SERVICE}"
  if (( rc != 0 )); then
    err "停止面板服务失败（systemctl 退出码 ${rc}）。配置已写为 ENABLED=0。"
    return 1
  fi

  if [[ "${state_before}" == "active" ]]; then
    ok "面板已关闭（服务已停止并禁用）。"
  else
    ok "面板本来就没在运行（保持关闭，已确保禁用）。"
  fi
  # 契约 v3 第 3 节：必须明确告知转发能力不受影响。
  info "端口映射转发不受影响（gost/gsm-egress/caddy 未动）。"
  panel_sync_db disable
  return 0
}

# gsm panel status [--json]：服务状态 / 监听地址 / 是否允许远程 / 最近开关。
# 退出码：0 服务运行中；1 未运行。
panel_status() {
  local as_json=0
  while (( $# > 0 )); do
    case "$1" in
      --json) as_json=1; shift ;;
      *) err "未知参数：$1"; return 1 ;;
    esac
  done

  local state enabled_flag bind port endpoint allow_remote conf_enabled
  state="$(panel_service_state)"
  enabled_flag="$(panel_service_enabled)"
  endpoint="$(panel_effective_bind)"
  bind="${endpoint%:*}"
  port="${endpoint##*:}"
  allow_remote="$(panel_conf_get ALLOW_REMOTE 0)"
  conf_enabled="$(panel_conf_get ENABLED 0)"

  # 最近一次开关时间与操作者来自 DB（app.py panel-status），失败不阻塞展示。
  # capture_app_out 是普通函数调用，失败会被 set -e 直接带走，必须经 capture_rc 包裹。
  local db_json="" db_rc=0
  capture_rc db_rc capture_app_out_quiet db_json panel-status --json
  if (( db_rc != 0 )); then
    db_json=""
  fi

  if (( as_json == 1 )); then
    local py
    py="$(resolve_python)" || py="python3"
    # 统一输出一个 JSON 对象：app.py 的值 + CLI 侧补的 systemd 实况。
    if (( db_rc == 0 )) && [[ -n "${db_json}" ]]; then
      printf "%s" "${db_json}" | "${py}" - "${state}" "${enabled_flag}" "${bind}" "${port}" "${allow_remote}" "${conf_enabled}" <<PYJSON 2>/dev/null || printf "%s\n" "${db_json}"
import json, sys
try:
    base = json.load(sys.stdin)
except Exception:
    base = {}
if not isinstance(base, dict):
    base = {}
truthy = ("1", "true", "yes", "on")
base.update({
    "service": sys.argv[1],
    "service_enabled": sys.argv[2],
    "bind": sys.argv[3],
    "port": sys.argv[4],
    "allow_remote": sys.argv[5].lower() in truthy,
    "conf_enabled": sys.argv[6].lower() in truthy,
    "running": sys.argv[1] == "active",
})
print(json.dumps(base, ensure_ascii=False, indent=2))
PYJSON
    else
      printf '{"service": "%s", "service_enabled": "%s", "bind": "%s", "port": "%s", "allow_remote": %s, "conf_enabled": %s, "running": %s}\n' \
        "${state}" "${enabled_flag}" "${bind}" "${port}" \
        "$([[ "${allow_remote}" == "1" ]] && echo true || echo false)" \
        "$([[ "${conf_enabled}" == "1" ]] && echo true || echo false)" \
        "$([[ "${state}" == "active" ]] && echo true || echo false)"
    fi
  else
    if (( db_rc == 0 )) && [[ -n "${db_json}" ]]; then
      printf "%s\n" "${db_json}"
    fi
    printf "服务状态：%s（开机自启：%s）\n" "${state}" "${enabled_flag}"
    printf "监听地址：%s\n" "${endpoint}"
    if [[ "${bind}" == "0.0.0.0" || "${bind}" == "::" || "${bind}" == "*" ]]; then
      warn "当前监听在所有网卡（ALLOW_REMOTE=${allow_remote}）——公网可直接访问面板端口。"
    else
      info "只监听本机 ${bind}。远程访问请用 SSH 隧道："
      printf "     ssh -L %s:127.0.0.1:%s root@<服务器IP>\n" "${port}" "${port}"
    fi
    # 只有 panel.conf 真的存在时才谈"不一致"：文件缺失时 ENABLED 只是默认值，
    # 老版本安装升上来的机器就属于这种情况（unit 仍绑 0.0.0.0，但没有 conf）。
    if [[ -f "${PANEL_CONF}" && "${conf_enabled}" != "1" && "${state}" == "active" ]]; then
      warn "panel.conf 写的是 ENABLED=${conf_enabled}，但服务正在运行——状态不一致，可执行 gsm panel on 或 off 校正。"
    fi
    if [[ ! -f "${PANEL_CONF}" ]]; then
      warn "尚未生成 ${PANEL_CONF}（老版本安装）：先执行一次 gsm panel on 或 gsm panel off 即可纳管。"
    fi
  fi

  # 契约 v3 第 3 节：0 = 服务运行中；1 = 未运行。
  [[ "${state}" == "active" ]] && return 0
  return 1
}

# gsm panel remote on|off：切换公网监听（契约 v3 第 4 节）。
panel_remote() {
  local want="${1:-}" rc=0 bind port
  case "${want}" in
    on|1|yes|true) ;;
    off|0|no|false) ;;
    *) err "用法：gsm panel remote on|off"; return 1 ;;
  esac

  port="$(panel_port)"
  if [[ "${want}" == "on" || "${want}" == "1" || "${want}" == "yes" || "${want}" == "true" ]]; then
    bind="0.0.0.0"
    # 醒目警告：这是把管理面板暴露到公网的唯一入口，必须写清风险。
    printf "\n%s%s%s\n" "${C_ERR}${C_BOLD}" "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" "${C_OFF}" >&2
    printf "%s%s%s\n" "${C_ERR}${C_BOLD}" "  警告：面板即将监听 0.0.0.0:${port}（对所有网络开放）" "${C_OFF}" >&2
    printf "%s%s%s\n" "${C_ERR}${C_BOLD}" "  管理面板暴露到公网 = 登录页可被全世界扫描与爆破。" "${C_OFF}" >&2
    printf "%s%s%s\n" "${C_ERR}${C_BOLD}" "  推荐保持 127.0.0.1 + SSH 隧道，而不是打开这个开关。" "${C_OFF}" >&2
    printf "%s%s%s\n\n" "${C_ERR}${C_BOLD}" "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" "${C_OFF}" >&2
  else
    bind="127.0.0.1"
  fi

  # 老版本安装可能还没有 panel.conf：先按当前 unit 的值补一份再改。
  capture_rc rc panel_conf_ensure
  if (( rc != 0 )); then
    err "面板参数文件不可用（退出码 ${rc}），未改动绑定地址。"
    return 1
  fi

  local allow_flag=0
  [[ "${bind}" == "0.0.0.0" ]] && allow_flag=1
  capture_rc rc panel_conf_set "BIND=${bind}" "ALLOW_REMOTE=${allow_flag}"
  if (( rc != 0 )); then
    err "写入 ${PANEL_CONF} 失败（退出码 ${rc}）。"
    return 1
  fi

  # 关键：unit 里的 --bind 是安装时展开的常量，只改 panel.conf 不会生效。
  # 必须写 drop-in 覆盖 ExecStart，并 daemon-reload + restart，
  # 保证「实际监听地址 == panel.conf 的 BIND」。
  panel_write_bind_dropin
  if (( $? != 0 )); then
    err "同步监听地址到 systemd 失败（见上面的报错）；panel.conf 已写入，但实际监听地址未变。"
    return 1
  fi

  if [[ "$(panel_service_state)" == "active" ]]; then
    ok "已重启面板服务使新绑定地址生效。"
  else
    ok "已写入绑定地址（面板当前未运行，下次 gsm panel on 时生效）。"
  fi

  if [[ "${bind}" == "0.0.0.0" ]]; then
    warn "现在监听 $(panel_effective_bind)：请确认防火墙已限制来源，或尽快执行 gsm panel remote off 收回。"
    panel_sync_db enable
  else
    ok "已恢复只监听 127.0.0.1:${port}。"
    panel_sync_db disable
  fi
  return 0
}

# 面板子命令分发。
cmd_panel() {
  local action="${1:-status}"
  if (( $# > 0 )); then
    shift
  fi
  case "${action}" in
    on|enable|start)      panel_enable "$@" ;;
    off|disable|stop)     panel_disable "$@" ;;
    status|show|"")       panel_status "$@" ;;
    remote|bind)
      if (( $# == 0 )); then
        err "用法：gsm panel remote on|off"
        return 1
      fi
      panel_remote "$@" ;;
    *)
      err "未知的 panel 子命令：${action}"
      err "用法：gsm panel on|off|status [--json]|remote on|remote off"
      return 1
      ;;
  esac
}

# ---------- 子命令 ----------

cmd_status() {
  local rc=0
  capture_rc rc run_app egress-show
  if (( rc != 0 )); then
    err "读取出口状态失败（退出码 ${rc}）：$(explain_rc "${rc}")。"
    return "${rc}"
  fi
  ok "状态读取完成"
}

cmd_on() {
  local mode="" allow="" item rc=0
  local -a domains=() extra=()
  while (( $# > 0 )); do
    case "$1" in
      --mode)
        [[ $# -ge 2 ]] || { err "--mode 需要一个取值：all 或 allowlist"; return 1; }
        mode="$2"; shift 2 ;;
      --mode=*)
        mode="${1#--mode=}"; shift ;;
      --allow)
        [[ $# -ge 2 ]] || { err "--allow 需要一个逗号分隔的域名列表"; return 1; }
        allow="$2"; shift 2 ;;
      --allow=*)
        allow="${1#--allow=}"; shift ;;
      *)
        err "未知参数：$1"; return 1 ;;
    esac
  done

  case "${mode}" in
    ""|all|allowlist) ;;
    *) err "--mode 只能是 all 或 allowlist，收到：${mode}"; return 1 ;;
  esac

  # 第一步：补域名（不改开关）。失败则开关保持原样。
  if [[ -n "${allow}" ]]; then
    local IFS=','
    for item in ${allow}; do
      [[ -n "${item}" ]] && domains+=("${item}")
    done
    if (( ${#domains[@]} > 0 )); then
      capture_rc rc apply_domains "${domains[@]}"
      if (( rc != 0 )); then
        err "写入放行域名失败（退出码 ${rc}）：$(explain_rc "${rc}")。"
        err "开关尚未改动，出口访问保持原状态。"
        return "${rc}"
      fi
      ok "已追加放行域名：${domains[*]}"
    fi
  fi

  # 第二步：改开关；保存成功但下发失败时按契约返回 3，并说明开关已改动。
  extra=(egress-set --enable)
  [[ -n "${mode}" ]] && extra+=(--mode "${mode}")
  capture_rc rc run_app "${extra[@]}"
  if (( rc == 3 )); then
    err "开关已改动（策略已保存），但数据面下发失败：$(explain_rc "${rc}")。"
    return 3
  elif (( rc != 0 )); then
    err "打开出口访问失败（退出码 ${rc}）：$(explain_rc "${rc}")。开关未生效。"
    return "${rc}"
  fi
  ok "出口访问已打开${mode:+（模式：${mode}）}。"
  cmd_status || true
}

cmd_off() {
  local rc=0
  capture_rc rc run_app egress-set --disable
  if (( rc == 3 )); then
    err "开关已改动（策略已保存），但数据面下发失败：$(explain_rc "${rc}")。"
    return 3
  elif (( rc != 0 )); then
    err "关闭出口访问失败（退出码 ${rc}）：$(explain_rc "${rc}")。开关未生效。"
    return "${rc}"
  fi
  ok "出口访问已关闭（所有出站被拒绝）。"
  cmd_status || true
}

cmd_domains() {
  local out="" rc=0
  capture_app_out out egress-domains
  rc=$?
  if (( rc != 0 )); then
    err "读取放行域名失败（退出码 ${rc}）：$(explain_rc "${rc}")。"
    return "${rc}"
  fi
  if [[ -z "${out}" ]]; then
    warn "当前没有放行域名（allowlist 模式下会拒绝所有出站）。"
    return 0
  fi
  printf '%s\n' "${out}"
}

cmd_allow() {
  if (( $# == 0 )); then
    err "用法：gsm allow a.com b.com"
    return 1
  fi
  local rc=0
  capture_rc rc apply_domains "$@"
  if (( rc != 0 )); then
    err "追加放行域名失败（退出码 ${rc}）：$(explain_rc "${rc}")。"
    return "${rc}"
  fi
  ok "已追加放行域名：$*"
  cmd_domains
}

cmd_deny() {
  if (( $# == 0 )); then
    err "用法：gsm deny a.com"
    return 1
  fi
  local py app rc=0 line token kept=0
  py="$(require_env)" || return 1
  app="$(resolve_app_dir)"

  local -A drop=()
  for token in "$@"; do
    token="$(normalize_token "${token}")"
    [[ -n "${token}" ]] && drop["${token}"]=1
  done

  local old_file keep_file
  old_file="$(mktemp)"
  keep_file="$(mktemp)"
  capture_rc rc load_domains
  local load_rc="${rc}"
  if (( load_rc != 0 )); then
    rm -f "${old_file}" "${keep_file}"
    err "读取放行域名失败（退出码 ${load_rc}）：$(explain_rc "${load_rc}")。"
    return "${load_rc}"
  fi
  load_domains > "${old_file}" || true

  while IFS= read -r line || [[ -n "${line}" ]]; do
    line="$(normalize_token "${line}")"
    [[ -z "${line}" ]] && continue
    if [[ -n "${drop[${line}]:-}" ]]; then
      continue
    fi
    printf '%s\n' "${line}" >> "${keep_file}"
    kept=$((kept + 1))
  done < "${old_file}"
  rm -f "${old_file}"

  capture_rc rc "${py}" "${app}/app.py" egress-set --domains-file "${keep_file}"
  rm -f "${keep_file}"
  if (( rc != 0 )); then
    err "删除放行域名失败（退出码 ${rc}）：$(explain_rc "${rc}")。"
    return "${rc}"
  fi
  ok "已删除放行域名：$*（剩余 ${kept} 条）"
  cmd_domains
}

cmd_test() {
  local host="${1:-${PROBE_HOST_DEFAULT}}"
  local port="${2:-${PROBE_PORT_DEFAULT}}"
  if ! [[ "${port}" =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
    err "端口无效：${port}"
    return 1
  fi
  local rc=0
  capture_rc rc run_app egress-probe --host "${host}" --port "${port}"
  if (( rc != 0 )); then
    err "出站探测失败（退出码 ${rc}）：$(explain_rc "${rc}")。"
    return "${rc}"
  fi
  ok "探测完成：${host}:${port}"
}

cmd_log() {
  local lines="${LOG_DEFAULT_LINES}" action="" rc=0
  local -a args=()
  while (( $# > 0 )); do
    case "$1" in
      -n|--lines)
        [[ $# -ge 2 ]] || { err "-n 需要一个数字"; return 1; }
        lines="$2"; shift 2 ;;
      -n*)
        lines="${1#-n}"; shift ;;
      --allow) action="allow"; shift ;;
      --block) action="block"; shift ;;
      *)
        err "未知参数：$1"; return 1 ;;
    esac
  done
  if ! [[ "${lines}" =~ ^[0-9]+$ ]] || (( lines < 1 )); then
    err "-n 需要一个正整数，收到：${lines}"
    return 1
  fi

  args=(egress-log --limit "${lines}")
  [[ -n "${action}" ]] && args+=(--action "${action}")
  capture_rc rc run_app "${args[@]}"
  if (( rc != 0 )); then
    err "读取访问流水失败（退出码 ${rc}）：$(explain_rc "${rc}")。"
    return "${rc}"
  fi
  ok "访问流水（最近 ${lines} 条${action:+，筛选：${action}}）"
}

cmd_doctor() {
  local rc=0
  capture_rc rc run_app egress-doctor
  case "${rc}" in
    0) ok "自检通过。" ;;
    1) warn "自检发现问题（退出码 1），详见上面的输出。" ;;
    *) err "自检执行失败（退出码 ${rc}）。" ;;
  esac
  return "${rc}"
}

cmd_install_cli() {
  local app src dst rc=0
  app="$(resolve_app_dir)"
  src="${BASH_SOURCE[0]:-}"
  dst="${app}/tools/gsm"

  if [[ "${EUID}" -ne 0 ]]; then
    err "安装 gsm 命令需要 root，请用：sudo gsm install-cli"
    return 1
  fi
  if [[ -z "${src}" || ! -f "${src}" ]]; then
    err "找不到自身脚本路径，无法安装。请手动复制到 ${dst}。"
    return 1
  fi
  if [[ "${src}" -ef "${dst}" ]]; then
    ok "已在 ${dst}，跳过复制。"
  else
    capture_rc rc mkdir -p "${app}/tools"
    if (( rc == 0 )); then
      capture_rc rc install -m 0755 "${src}" "${dst}"
    fi
    if (( rc != 0 )); then
      err "复制到 ${dst} 失败（退出码 ${rc}）。"
      return "${rc}"
    fi
    ok "已安装：${dst}"
  fi

  capture_rc rc ln -sf "${dst}" /usr/local/bin/gsm
  if (( rc != 0 )); then
    err "创建符号链接 /usr/local/bin/gsm 失败（退出码 ${rc}）。"
    return "${rc}"
  fi
  ok "已创建符号链接：/usr/local/bin/gsm -> ${dst}"
  info "现在可以直接运行：gsm status"
}

cmd_version() {
  printf 'gsm %s\n' "${GSM_VERSION}"
  local py app
  if py="$(resolve_python)" && app="$(resolve_app_dir)" && [[ -f "${app}/app.py" ]]; then
    printf 'app.py: %s\n' "${app}/app.py"
    printf 'python: %s\n' "${py}"
  fi
}

main() {
  local cmd="${1:-status}"
  if (( $# > 0 )); then
    shift
  fi
  case "${cmd}" in
    status|show)          cmd_status "$@" ;;
    on|enable)            cmd_on "$@" ;;
    off|disable)          cmd_off "$@" ;;
    allow|add)            cmd_allow "$@" ;;
    deny|del|remove)      cmd_deny "$@" ;;
    domains|list)         cmd_domains "$@" ;;
    test|probe)           cmd_test "$@" ;;
    log|logs)             cmd_log "$@" ;;
    doctor|diag)          cmd_doctor "$@" ;;
    panel|web|ui)         cmd_panel "$@" ;;
    install-cli|install)  cmd_install_cli "$@" ;;
    version|-v|--version) cmd_version "$@" ;;
    help|-h|--help)       usage ;;
    *)
      err "未知命令：${cmd}"
      usage >&2
      return 1
      ;;
  esac
}

main "$@"
